# GMGN（聪明钱 / 庄地址源）。免费 key 在 https://gmgn.ai/ai 申请（Ed25519 公钥对，无需私钥）
GMGN_API_KEY=

# Jev（TypeSafe 决策模型，做最终裁决）。免费 $5 额度在 https://console.typesafe.ai 注册获取
# 不填则自动降级回启发式引擎（不报错）
TYPESAFE_API_KEY=
# 可选：走 OpenRouter / Opper 等网关时填其 /v1/systemone 地址；留空用官方 api.typesafe.ai
JEV_BASE_URL=

# 邮箱推送（推到你的邮箱，地址你后补）
EMAIL_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 可选：LunarCrush 社媒注意力（真实社交量/Galaxy Score）。留空则用代理指标
LUNARCRUSH_API_KEY=
