# GMGN（聪明钱 / 庄地址源）。免费 key 在 https://gmgn.ai/ai 申请（Ed25519 公钥对，无需私钥）
GMGN_API_KEY=

# Jev 决策模型（最终裁决）。推荐走 Vercel AI Gateway（免费 $5/月额度，Jev 为 free-tier 模型）
# 注册 Vercel → AI Gateway → API Keys 拿 key 填这里；不填则自动降级回启发式引擎（不报错）
AI_GATEWAY_API_KEY=
# 可选：TypeSafe 直连 key（https://console.typesafe.ai，新注册已无送额度；可作 Vercel BYOK）
TYPESAFE_API_KEY=
# 可选：强制覆盖 endpoint（如 OpenRouter/Opper 网关）；留空按 settings.json 的 provider 推导
JEV_BASE_URL=

# 邮箱推送（推到你的邮箱，地址你后补）
EMAIL_TO=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 可选：LunarCrush 社媒注意力（真实社交量/Galaxy Score）。留空则用代理指标
LUNARCRUSH_API_KEY=
